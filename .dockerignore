# The build context is sent to the daemon in full, so keep it to what the
# Dockerfile actually copies. Without this the 253 MB working tree and every
# node_modules go over the wire on each build.
**/node_modules
**/dist
**/.git
.git
.venv
__pycache__/
**/*.pyc
.pytest_cache/
*.egg-info/

# Built artifacts and caches
server/data/*.db
server/data/*.db-shm
server/data/*.db-wal
web/dist
web/test-results
web/playwright-report
data/raw
data/interim

# Not needed to build or run the service
docs/
tests/
src/
scripts/
Makefile
pyproject.toml
*.md
!README.md
